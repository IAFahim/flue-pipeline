#!/usr/bin/env bash
# sync-skills — pull the retrofitted Unity skills from the source of truth
# (~/.claude/skills) into this repo's src/skills/, ALSO distribute each into its
# owning Unity package's Plugins~/skills/, then sanity-check that every mastery
# skill is wired into src/track-experts.ts and that the repo still typechecks.
#
# Source of truth stays ~/.claude/skills. Both the flue copies (src/skills) and
# the package copies (Plugins~/skills) are GENERATED — never hand-edit them.
#
# Synced (full replace per dir): unity-cli, unity-agent-protocol,
# unity-player-input, unity-stage-foundations, unity-augment-architecture,
# unity-track-*.
# NEVER touched (flue-local skills): chat, track-task, track-undo, spawn, echo, outline.
set -euo pipefail

SRC="${SKILLS_SRC:-$HOME/.claude/skills}"
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DST="$REPO/src/skills"
EXPERTS="$REPO/src/track-experts.ts"

[ -d "$SRC" ] || { echo "FATAL: skill source $SRC not found" >&2; exit 1; }
[ -d "$DST" ] || { echo "FATAL: $DST not found" >&2; exit 1; }

echo "== sync-skills: $SRC -> $DST"

synced=0
names=()
for dir in "$SRC"/unity-cli "$SRC"/unity-agent-protocol "$SRC"/unity-player-input "$SRC"/unity-stage-foundations "$SRC"/unity-augment-architecture "$SRC"/unity-track-*; do
	[ -d "$dir" ] || continue
	name="$(basename "$dir")"
	[ -f "$dir/SKILL.md" ] || { echo "SKIP $name (no SKILL.md)"; continue; }
	rm -rf "${DST:?}/$name"
	# -L: dereference symlinks — skill sources under ~/.claude/skills may be
	# symlinks into the umbrella repo, and flue's packager refuses symlinks.
	cp -rL "$dir" "$DST/$name"
	synced=$((synced + 1))
	names+=("$name")
	echo "synced  $name"
done
echo "== synced $synced skill dir(s)"

# --- distribute into Unity package Plugins~/skills (the 3rd copy target) -----
# Each mastery skill ships inside the BovineLabs package that owns its track;
# shared/basic skills and anything unmapped fall back to BovineLabs.Timeline.Core.
# The Packages dir is DISCOVERED, never hardcoded: $VEX_PACKAGES wins, else the
# unity-codex project_path (~/.unity-codex/settings.json) + /Packages. If no
# packages dir is found, distribution is skipped (flue's own sync still stands).
PKGS="${VEX_PACKAGES:-}"
if [ -z "$PKGS" ]; then
	proj="$(node -e 'try{const fs=require("fs"),os=require("os"),p=require("path");const s=JSON.parse(fs.readFileSync(p.join(os.homedir(),".unity-codex","settings.json"),"utf8"));process.stdout.write(s.project_path||"")}catch{process.stdout.write("")}' 2>/dev/null || true)"
	[ -n "$proj" ] && PKGS="$proj/Packages"
fi

if [ -z "$PKGS" ] || [ ! -d "$PKGS" ]; then
	echo "== packages: SKIP (no Packages dir; set VEX_PACKAGES or unity-codex project_path)"
else
	echo "== distribute to packages: $PKGS"
	declare -A PKG_OF=(
		[unity-track-transform-position]=com.bovinelabs.timeline.transform
		[unity-track-transform-rotation]=com.bovinelabs.timeline.transform
		[unity-track-transform-scale]=com.bovinelabs.timeline.transform
		[unity-track-physics-force]=BovineLabs.Timeline.Physics
		[unity-track-physics-drag]=BovineLabs.Timeline.Physics
		[unity-track-physics-linear-pid]=BovineLabs.Timeline.Physics
		[unity-track-physics-angular-pid]=BovineLabs.Timeline.Physics
		[unity-track-physics-gravity-override]=BovineLabs.Timeline.Physics
		[unity-track-physics-kinematic-override]=BovineLabs.Timeline.Physics
		[unity-track-physics-filter-override]=BovineLabs.Timeline.Physics
		[unity-track-essence-stat]=BovineLabs.Timeline.Essence
		[unity-track-essence-event]=BovineLabs.Timeline.Essence
		[unity-track-essence-intrinsic]=BovineLabs.Timeline.Essence
		[unity-track-entitylink-copytransform]=BovineLabs.Timeline.EntityLinks
		[unity-track-entitylink-parent]=BovineLabs.Timeline.EntityLinks
		[unity-track-entitylink-mutate]=BovineLabs.Timeline.EntityLinks
		[unity-track-entitylink-targetpatch]=BovineLabs.Timeline.EntityLinks
		[unity-track-distance-to-stat]=BovineLabs.Timeline.Distance
		[unity-track-timeline-timescale]=BovineLabs.Timeline.Time
		[unity-track-world-timescale]=BovineLabs.Timeline.Time
		[unity-track-subdirector]=BovineLabs.Timeline.Core
		[unity-stage-foundations]=BovineLabs.Timeline.Core
		[unity-cli]=BovineLabs.Timeline.Core
		[unity-agent-protocol]=BovineLabs.Timeline.Core
		[unity-player-input]=BovineLabs.Timeline.Core
		[unity-augment-architecture]=BovineLabs.Timeline.Core
	)
	dist=0
	for name in "${names[@]}"; do
		pkg="${PKG_OF[$name]:-BovineLabs.Timeline.Core}"
		[ -n "${PKG_OF[$name]:-}" ] || echo "  note: $name unmapped -> BovineLabs.Timeline.Core"
		base="$PKGS/$pkg"
		[ -d "$base" ] || { echo "  WARN: package $pkg not found, skipping $name"; continue; }
		dest="$base/Plugins~/skills/$name"
		mkdir -p "$(dirname "$dest")"
		rm -rf "$dest"
		cp -rL "$DST/$name" "$dest"
		dist=$((dist + 1))
	done
	echo "== distributed $dist skill(s) into packages"

	# Make each package a self-contained Claude plugin (App UI's convention):
	# .claude-plugin/{plugin,marketplace}.json + skills.json, derived from the
	# SKILL.md frontmatter so they never drift. Regenerated every sync.
	if node "$REPO/scripts/gen-skill-plugin-manifests.mjs" "$PKGS"; then
		echo "== package plugin manifests: OK"
	else
		echo "== package plugin manifests: FAILED" >&2
	fi
fi

# Verify every synced MASTERY skill (stage-foundations + track-*) has a registry
# entry in track-experts.ts. unity-cli / unity-agent-protocol are carried by
# every expert, not registry keys, so they are exempt.
missing=0
for name in "${names[@]}"; do
	case "$name" in
	unity-cli | unity-agent-protocol | unity-player-input) continue ;;
	esac
	if ! grep -q "'$name'" "$EXPERTS"; then
		echo "MISSING expert entry for mastery skill: $name (add it to $EXPERTS)"
		missing=$((missing + 1))
	fi
done
if [ "$missing" -eq 0 ]; then
	echo "== expert registry: OK (every synced mastery skill has an entry)"
else
	echo "== expert registry: $missing mastery skill(s) missing entries" >&2
fi

echo "== typecheck"
if (cd "$REPO" && npm run --silent typecheck); then
	echo "== typecheck: PASS"
else
	echo "== typecheck: FAIL" >&2
	exit 1
fi

[ "$missing" -eq 0 ] || exit 1
